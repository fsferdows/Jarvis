# Meta Ads API & CLI Credentials
# Obtain your access token from Meta Business Suite (System User token with ads_read / ads_management)
META_ACCESS_TOKEN=your_meta_system_user_token_here

# Your Meta Ad Account ID (e.g., act_123456789012345 or 123456789012345)
META_AD_ACCOUNT_ID=act_123456789012345

# Optional: Meta Pixel / Dataset ID for event testing
META_PIXEL_ID=123456789012345

